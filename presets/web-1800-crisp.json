{
  "version": 1,
  "name": "web-1800-crisp",
  "description": "Stronger web export at 1800 px for detailed subjects; watch high-contrast edges.",
  "experimental": true,
  "resize": {
    "enabled": true,
    "longEdge": 1800,
    "allowUpscale": false
  },
  "denoise": {
    "engine": "guidedFilter",
    "amount": 1.00,
    "threshold": 2.00,
    "radius": 2.0
  },
  "outputSharpen": {
    "fine": {
      "radius": 0.35,
      "amount": 11.40,
      "darkAmount": 0.85,
      "lightAmount": 0.55
    },
    "medium": {
      "radius": 0.90,
      "amount": 3.40,
      "darkAmount": 0.80,
      "lightAmount": 0.50
    },
    "noiseProtection": 1.00,
    "edgeProtection": 0.60,
    "haloProtection": 0.80
  },
  "output": {
    "quality": 90
  }
}
