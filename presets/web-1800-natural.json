{
  "version": 1,
  "name": "web-1800-natural",
  "description": "Balanced web export at 1800 px long edge — the default for online galleries.",
  "resize": {
    "enabled": true,
    "longEdge": 1800,
    "allowUpscale": false
  },
  "denoise": {
    "engine": "guidedFilter",
    "amount": 1.00,
    "threshold": 2.00,
    "radius": 2.0
  },
  "outputSharpen": {
    "fine": {
      "radius": 0.35,
      "amount": 13.44,
      "darkAmount": 0.80,
      "lightAmount": 0.50
    },
    "medium": {
      "radius": 0.90,
      "amount": 4.03,
      "darkAmount": 0.80,
      "lightAmount": 0.50
    },
    "noiseProtection": 1.00,
    "edgeProtection": 0.65,
    "haloProtection": 0.70
  },
  "output": {
    "quality": 90
  }
}
