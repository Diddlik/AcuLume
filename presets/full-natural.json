{
  "version": 1,
  "name": "full-natural",
  "description": "Gentle sharpening at full resolution, for prints and archival exports.",
  "resize": {
    "enabled": false
  },
  "denoise": {
    "engine": "guidedFilter",
    "amount": 1.00,
    "threshold": 2.00,
    "radius": 2.0
  },
  "outputSharpen": {
    "fine": {
      "radius": 0.60,
      "amount": 2.66,
      "darkAmount": 0.80,
      "lightAmount": 0.60
    },
    "medium": {
      "radius": 1.40,
      "amount": 0.83,
      "darkAmount": 0.75,
      "lightAmount": 0.55
    },
    "noiseProtection": 1.00,
    "edgeProtection": 0.40,
    "haloProtection": 0.50
  },
  "output": {
    "quality": 92
  }
}
