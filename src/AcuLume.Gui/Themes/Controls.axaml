<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Text roles ===== -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Uppercase group label, e.g. "PRESET", "OUTPUT" -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <!-- Panel section title, e.g. "Sharpening", "Protection" -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Divider caption for a band group, e.g. "FINE DETAIL" -->
  <Style Selector="TextBlock.band">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="Foreground" Value="#8B939C" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ===== Divider ===== -->

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource PanelBorder}" />
  </Style>

  <!-- ===== Segmented control (RadioButton group inside Border.segments) ===== -->

  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="RadioButton.segment">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="3" Padding="9,3">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontFamily="{TemplateBinding FontFamily}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundActive}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ===== Slider ===== -->

  <Style Selector="Slider:horizontal">
    <Setter Property="Height" Value="14" />
    <Setter Property="MinHeight" Value="14" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Height="14">
          <Panel VerticalAlignment="Center">
            <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource TrackBackground}" />
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="False"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Focusable="False" Height="3" VerticalAlignment="Center">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Height="3" CornerRadius="2" Background="{DynamicResource Accent}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Focusable="False" Height="14" VerticalAlignment="Center">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb Width="12" Height="12">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Ellipse Width="12" Height="12" Fill="{DynamicResource Knob}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Slider:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- ===== Buttons ===== -->

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.ghost /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  </Style>
  <Style Selector="ToggleButton.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="#7C858D" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentButton}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonHover}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <!-- Preset library card -->
  <Style Selector="Button.card">
    <Setter Property="Width" Value="270" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="Padding" Value="13,12" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="#111417" />
    <Setter Property="BorderBrush" Value="#1F252B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter">
    <Setter Property="Background" Value="#111417" />
    <Setter Property="BorderBrush" Value="#1F252B" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#141820" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
  </Style>
  <Style Selector="Button.card.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ===== Checkbox ===== -->

  <Style Selector="CheckBox.compact">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="box" Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                BorderBrush="{DynamicResource ControlBorderHover}"
                Background="{DynamicResource ControlBackground}">
          <Path Name="check" Stretch="Uniform" Margin="2.5"
                Data="M5 13l4 4L19 7"
                Stroke="{DynamicResource Knob}" StrokeThickness="3"
                StrokeLineCap="Round" StrokeJoin="Round"
                IsVisible="False" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.compact:checked /template/ Border#box">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="CheckBox.compact:checked /template/ Path#check">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Stroke" Value="#0A0B0C" />
  </Style>

  <!-- ===== help disclosure ===== -->
  <Style Selector="ToggleButton.helpToggle">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="4" Padding="7,3" Background="Transparent"
                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.helpToggle:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.helpToggle:checked">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.helpToggle:checked /template/ Border#bg">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ===== ComboBox ===== -->

  <Style Selector="ComboBox.flat">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="#262C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ===== NumericUpDown / TextBox ===== -->

  <Style Selector="TextBox.mono">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="#262C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ===== Scrollbars ===== -->

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
