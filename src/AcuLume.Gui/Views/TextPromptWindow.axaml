<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AcuLume.Gui.Views.TextPromptWindow"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextPrimary}">

  <StackPanel Margin="18" Spacing="14">
    <TextBox Name="Input" Classes="mono" KeyDown="OnInputKeyDown" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
      <Button Classes="primary" Padding="14,6" Content="OK" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
