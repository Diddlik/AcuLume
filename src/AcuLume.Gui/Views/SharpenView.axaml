<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcuLume.Gui.ViewModels"
             x:Class="AcuLume.Gui.Views.SharpenView"
             x:DataType="vm:SharpenViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="HelpStrip" DataType="vm:HelpTopic">
      <StackPanel Margin="0,6,0,0">
        <ToggleButton Classes="helpToggle" IsChecked="{Binding IsExpanded}"
                      Content="What does this do?" HorizontalAlignment="Left" />
        <Border IsVisible="{Binding IsExpanded}" Margin="0,8,0,2"
                Background="{DynamicResource InsetBackground}" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondary}" />
            <Grid ColumnDefinitions="150,6,150" HorizontalAlignment="Left">
              <StackPanel Grid.Column="0" Spacing="3">
                <Image Source="{Binding BeforeImage}" Width="150" Height="150" Stretch="None" />
                <TextBlock Text="off" FontSize="10.5" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <Image Source="{Binding AfterImage}" Width="150" Height="150" Stretch="None" />
                <TextBlock Text="on" FontSize="10.5" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Scale}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{DynamicResource TextFaint}" FontStyle="Italic" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="*,346">

    <!-- ================= PREVIEW COLUMN ================= -->
    <DockPanel Grid.Column="0" Background="{DynamicResource AppBackground}">

      <!-- toolbar -->
      <Border DockPanel.Dock="Top" Height="44" Background="{DynamicResource ToolbarBackground}"
              BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">

          <Border Classes="segments">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" Content="Fit" GroupName="Zoom"
                           IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch}, ConverterParameter=Fit}" />
              <RadioButton Classes="segment" Content="100%" GroupName="Zoom"
                           FontFamily="{DynamicResource MonoFont}"
                           IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch}, ConverterParameter=Percent100}" />
              <RadioButton Classes="segment" Content="200%" GroupName="Zoom"
                           FontFamily="{DynamicResource MonoFont}"
                           IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch}, ConverterParameter=Percent200}" />
            </StackPanel>
          </Border>

          <Border Width="1" Height="20" Background="{DynamicResource ControlBorder}" Margin="2,0" />

          <Border Classes="segments">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" Content="Before" GroupName="View"
                           IsChecked="{Binding PreviewMode, Converter={StaticResource EnumMatch}, ConverterParameter=Before}" />
              <RadioButton Classes="segment" Content="After" GroupName="View"
                           IsChecked="{Binding PreviewMode, Converter={StaticResource EnumMatch}, ConverterParameter=After}" />
              <RadioButton Classes="segment" Content="Split View" GroupName="View"
                           IsChecked="{Binding PreviewMode, Converter={StaticResource EnumMatch}, ConverterParameter=Split}" />
            </StackPanel>
          </Border>

          <Button Classes="ghost" Content="Open Image…" Click="OnOpenImage" />

          <ToggleButton Classes="ghost" Content="Histogram" IsChecked="{Binding ShowHistogram}"
                        Padding="10,4" FontSize="11.5" />

          <Panel Width="24" />

          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                      IsVisible="{Binding HasImage}">
            <TextBlock Classes="mono" FontSize="11" Foreground="#7C858D">
              <Run Text="{Binding SourceWidth}" /><Run Text=" × " /><Run Text="{Binding SourceHeight}" />
            </TextBlock>
            <TextBlock Text="→" Foreground="{DynamicResource Accent}" FontSize="11" />
            <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondary}">
              <Run Text="{Binding OutputWidth}" /><Run Text=" × " /><Run Text="{Binding OutputHeight}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- status strip -->
      <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource ToolbarBackground}"
              BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0">
        <Grid Margin="12,0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="10.5"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
          <TextBlock Grid.Column="1" Text="Rendering…" FontSize="10.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource Accent}" IsVisible="{Binding IsRendering}" />
        </Grid>
      </Border>

      <!-- canvas -->
      <Border Background="{DynamicResource CanvasBackground}">
        <ScrollViewer Name="PreviewViewport" Padding="22"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

          <!-- Size is set from code-behind: "Fit" tracks the viewport, 100%/200% uses output pixels. -->
          <Panel Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Open an image to preview sharpening"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextGhost}"
                       IsVisible="{Binding !HasImage}" />

            <!-- sharpened result -->
            <Image Source="{Binding AfterImage}" Stretch="Uniform" />

            <!-- unsharpened original, clipped to the split fraction -->
            <Grid IsVisible="{Binding ShowBeforeLayer}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SplitPosition, Converter={StaticResource StarLength}}" />
                <ColumnDefinition Width="{Binding SplitPosition, Converter={StaticResource StarLength}, ConverterParameter=invert}" />
              </Grid.ColumnDefinitions>
              <!-- The image keeps the full host size and is clipped by the column, so both layers align. -->
              <Border Grid.Column="0" ClipToBounds="True">
                <Image Source="{Binding BeforeImage}" Stretch="Uniform"
                       Width="{Binding #PreviewHost.Bounds.Width}"
                       Height="{Binding #PreviewHost.Bounds.Height}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
              </Border>
            </Grid>

            <!-- split handle -->
            <Grid IsVisible="{Binding IsSplit}" PointerPressed="OnSplitPointerPressed"
                  PointerMoved="OnSplitPointerMoved" PointerReleased="OnSplitPointerReleased"
                  Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SplitPosition, Converter={StaticResource StarLength}}" />
                <ColumnDefinition Width="{Binding SplitPosition, Converter={StaticResource StarLength}, ConverterParameter=invert}" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                      Background="#D9FFFFFF" IsHitTestVisible="False" />
              <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-13,0,0,0"
                      Background="#D90C0E10" BorderBrush="#99FFFFFF" BorderThickness="1"
                      Cursor="SizeWestEast">
                <Path Data="M9 8l-4 4 4 4M15 8l4 4-4 4" Stretch="Uniform" Margin="6"
                      Stroke="#EDF1F4" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
              </Border>
            </Grid>

            <!-- histogram overlay -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,10" Width="172"
                    Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" CornerRadius="5" Padding="8"
                    IsVisible="{Binding ShowHistogram}">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Histogram}" Height="44">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Double">
                      <Border Margin="0.5,0,0.5,0" VerticalAlignment="Bottom" Background="#7E8B96"
                              CornerRadius="1,1,0,0"
                              Height="{Binding Converter={StaticResource Scale}, ConverterParameter=44}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,0">
                  <TextBlock Grid.Column="0" Classes="mono" FontSize="9" Text="0"
                             Foreground="{DynamicResource TextFaint}" />
                  <TextBlock Grid.Column="1" Classes="mono" FontSize="9" Text="Luminance"
                             HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                  <TextBlock Grid.Column="2" Classes="mono" FontSize="9" Text="255"
                             Foreground="{DynamicResource TextFaint}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- corner labels -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10"
                    Background="{DynamicResource OverlayBackground}" CornerRadius="4" Padding="8,3"
                    IsVisible="{Binding ShowBeforeLayer}">
              <TextBlock Text="ORIGINAL" FontSize="10.5" LetterSpacing="1"
                         Foreground="{DynamicResource TextSecondary}" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,10"
                    Background="{DynamicResource OverlayBackground}" CornerRadius="4" Padding="8,3"
                    IsVisible="{Binding IsSplit}">
              <TextBlock Text="ACULUME" FontSize="10.5" LetterSpacing="1"
                         Foreground="{DynamicResource Accent}" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,10"
                    Background="{DynamicResource OverlayBackground}" CornerRadius="4" Padding="8,3"
                    IsVisible="{Binding HasImage}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="mono" FontSize="10.5" Text="{Binding ZoomLabel}"
                           Foreground="#9AA3AB" />
                <TextBlock Classes="mono" FontSize="10.5" Text="·" Foreground="#9AA3AB" />
                <TextBlock Classes="mono" FontSize="10.5" Text="{Binding FileName}" Foreground="#9AA3AB" />
              </StackPanel>
            </Border>
          </Panel>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <!-- ================= PARAMETER PANEL ================= -->
    <Border Grid.Column="1" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
      <DockPanel>

        <!-- export footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
                Padding="16,12">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="section" Text="TARGET FILE" Margin="0,0,0,3" />
                <TextBlock Classes="mono" FontSize="11.5" Text="{Binding SuggestedOutputName}"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary" Content="Export" Click="OnExport"
                      IsEnabled="{Binding HasImage}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsExporting}">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
              <TextBlock FontSize="11.5" Text="Processing…" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasExport}">
              <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Success}"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" FontSize="11.5" Text="Completed" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
              <Button Grid.Column="2" Classes="ghost" Padding="10,3" FontSize="11"
                      Content="Open Folder" Command="{Binding RevealExportCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,18">

            <!-- preset -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
              <TextBlock Grid.Column="0" Classes="section" Text="PRESET" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Classes="link" Content="Save as…" Click="OnSavePreset" />
                <Button Classes="link" Content="Reset" Command="{Binding ResetPresetCommand}" />
              </StackPanel>
            </Grid>
            <ComboBox Classes="flat" HorizontalAlignment="Stretch" Margin="0,0,0,16"
                      ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />

            <!-- output -->
            <TextBlock Classes="section" Text="OUTPUT" Margin="0,0,0,8" />
            <Border Classes="segments" Margin="0,0,0,10">
              <UniformGrid Columns="3">
                <RadioButton Classes="segment" Content="Full Resolution" GroupName="Target"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding OutputTarget, Converter={StaticResource EnumMatch}, ConverterParameter=Full}" />
                <RadioButton Classes="segment" Content="Web" GroupName="Target"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding OutputTarget, Converter={StaticResource EnumMatch}, ConverterParameter=Web}" />
                <RadioButton Classes="segment" Content="Custom" GroupName="Target"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding OutputTarget, Converter={StaticResource EnumMatch}, ConverterParameter=Custom}" />
              </UniformGrid>
            </Border>
            <Grid ColumnDefinitions="62,Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
              <TextBlock Grid.Column="0" Classes="label" Text="Long edge" FontSize="11.5" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Classes="mono" Width="86"
                       Text="{Binding LongEdge}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <CheckBox Classes="compact" IsChecked="{Binding AllowUpscale}" VerticalAlignment="Center" />
                <TextBlock Text="Upscale" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </Grid>

            <Border Classes="divider" Margin="0,0,0,16" />

            <!-- capture sharpening: runs before the resize (spec section 21) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="Capture Sharpening" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="hint" Text="before resize" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="segments" Margin="0,0,0,10">
              <UniformGrid Columns="3">
                <RadioButton Classes="segment" Content="Off" GroupName="Capture"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding CaptureLevel, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                <RadioButton Classes="segment" Content="Low" GroupName="Capture"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding CaptureLevel, Converter={StaticResource EnumMatch}, ConverterParameter=Low}" />
                <RadioButton Classes="segment" Content="Normal" GroupName="Capture"
                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             IsChecked="{Binding CaptureLevel, Converter={StaticResource EnumMatch}, ConverterParameter=Normal}" />
              </UniformGrid>
            </Border>

            <StackPanel IsVisible="{Binding IsCaptureEnabled}" Margin="0,0,0,4">
              <Border Classes="segments" Margin="0,0,0,10">
                <UniformGrid Columns="2">
                  <RadioButton Classes="segment" Content="Fine restore" GroupName="CaptureEngine"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               IsChecked="{Binding CaptureEngine, Converter={StaticResource EnumMatch}, ConverterParameter=FineRestore}" />
                  <RadioButton Classes="segment" Content="Richardson-Lucy" GroupName="CaptureEngine"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               IsChecked="{Binding CaptureEngine, Converter={StaticResource EnumMatch}, ConverterParameter=RichardsonLucy}" />
                </UniformGrid>
              </Border>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Assumed blur" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="1" Classes="mono"
                           Text="{Binding CaptureRadius, StringFormat='{}{0:0.00} px'}" />
              </Grid>
              <Slider Minimum="0.35" Maximum="2.5" Value="{Binding CaptureRadius}" />

              <StackPanel IsVisible="{Binding IsRichardsonLucy}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,6">
                  <TextBlock Grid.Column="0" Text="Iterations" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding CaptureIterations}" />
                </Grid>
                <Slider Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CaptureIterations}" />
              </StackPanel>

              <TextBlock Classes="hint" Margin="0,6,0,0" Text="{Binding CaptureHint}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" Margin="0,16,0,16" />

            <!-- noise reduction: between resize and sharpening -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="Noise Reduction" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="hint" Text="before sharpening" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
              <TextBlock Grid.Column="0" Text="Strength" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Grid.Column="1" Classes="mono"
                         Text="{Binding DenoiseAmount, StringFormat='{}{0:0.00}'}" />
            </Grid>
            <Slider Minimum="0" Maximum="1" Value="{Binding DenoiseAmount}" />

            <StackPanel IsVisible="{Binding IsDenoiseEnabled}">
              <Border Classes="segments" Margin="0,10,0,0">
                <UniformGrid Columns="3">
                  <RadioButton Classes="segment" Content="Guided" GroupName="Denoise"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               IsChecked="{Binding DenoiseEngine, Converter={StaticResource EnumMatch}, ConverterParameter=GuidedFilter}" />
                  <RadioButton Classes="segment" Content="Multi-scale" GroupName="Denoise"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               IsChecked="{Binding DenoiseEngine, Converter={StaticResource EnumMatch}, ConverterParameter=MultiScaleShrinkage}" />
                  <RadioButton Classes="segment" Content="Non-local" GroupName="Denoise"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               IsChecked="{Binding DenoiseEngine, Converter={StaticResource EnumMatch}, ConverterParameter=NonLocalMeans}" />
                </UniformGrid>
              </Border>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,6">
                <TextBlock Grid.Column="0" Text="Threshold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="1" Classes="mono"
                           Text="{Binding DenoiseThreshold, StringFormat='{}{0:0.0} σ'}" />
              </Grid>
              <Slider Minimum="0.5" Maximum="{x:Static vm:SharpenViewModel.MaxDenoiseThreshold}"
                      Value="{Binding DenoiseThreshold}" />
              <TextBlock Classes="hint" Margin="0,5,0,0" TextWrapping="Wrap"
                         Text="Detail below this many measured noise sigmas is removed before sharpening, so raising the amounts costs almost no extra grain." />
              <ContentControl Content="{Binding DenoiseHelp}" ContentTemplate="{StaticResource HelpStrip}" />
            </StackPanel>

            <Border Classes="divider" Margin="0,16,0,16" />

            <!-- sharpening -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Grid.Column="0" Classes="title" Text="Sharpening" />
              <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5" Text="adaptive · multi-frequency"
                         Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Margin="0,0,0,18">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Overall" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Overall, StringFormat='{}{0:0.00}×'}" />
              </Grid>
              <Slider Minimum="0" Maximum="{x:Static vm:SharpenViewModel.MaxOverall}" Value="{Binding Overall}" />
            </StackPanel>

            <!-- fine band -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Classes="band" Text="FINE DETAIL" />
              <Border Grid.Column="1" Height="1" Background="{DynamicResource SubtleBorder}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="0,0,0,14">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Amount" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FineAmount, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="{x:Static vm:SharpenViewModel.MaxBandAmount}" Value="{Binding FineAmount}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,20">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Radius" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FineRadius, StringFormat='{}{0:0.00} px'}" />
              </Grid>
              <Slider Minimum="0.35" Maximum="{x:Static vm:SharpenViewModel.MaxBandRadius}" Value="{Binding FineRadius}" />
              <ContentControl Content="{Binding FineHelp}" ContentTemplate="{StaticResource HelpStrip}" />

            </StackPanel>

            <!-- medium band -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Classes="band" Text="MEDIUM DETAIL" />
              <Border Grid.Column="1" Height="1" Background="{DynamicResource SubtleBorder}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="0,0,0,14">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Amount" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MediumAmount, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="{x:Static vm:SharpenViewModel.MaxBandAmount}" Value="{Binding MediumAmount}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,20">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Radius" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MediumRadius, StringFormat='{}{0:0.00} px'}" />
              </Grid>
              <Slider Minimum="0.35" Maximum="{x:Static vm:SharpenViewModel.MaxBandRadius}" Value="{Binding MediumRadius}" />
              <ContentControl Content="{Binding MediumHelp}" ContentTemplate="{StaticResource HelpStrip}" />

            </StackPanel>

            <Border Classes="divider" Margin="0,0,0,16" />

            <!-- halo balance -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Classes="title" Text="Halo Balance" />
              <TextBlock Grid.Column="1" Text="Light / Dark detail" FontSize="10.5"
                         Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="0,0,0,14">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Dark Detail" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding DarkDetail, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="{x:Static vm:SharpenViewModel.MaxDetailWeight}" Value="{Binding DarkDetail}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="label" Text="Light Detail" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LightDetail, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="{x:Static vm:SharpenViewModel.MaxDetailWeight}" Value="{Binding LightDetail}" />
            </StackPanel>
            <TextBlock Classes="hint" Margin="0,0,0,20"
                       Text="Lower Light Detail to reduce bright halos around high-contrast edges." />
            <ContentControl Content="{Binding BalanceHelp}" ContentTemplate="{StaticResource HelpStrip}" />


            <Border Classes="divider" Margin="0,0,0,16" />

            <!-- protection -->
            <TextBlock Classes="title" Text="Protection" Margin="0,0,0,12" />

            <StackPanel Margin="0,0,0,16">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox Grid.Column="0" Classes="compact" IsChecked="{Binding NoiseProtectionEnabled}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Noise protection" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="2" Classes="mono"
                           Text="{Binding NoiseProtectionAmount, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="1" Value="{Binding NoiseProtectionAmount}"
                      IsEnabled="{Binding NoiseProtectionEnabled}" />
              <TextBlock Classes="hint" Margin="0,5,0,0"
                         Text="Suppresses small detail likely to be sensor noise." />
              <ContentControl Content="{Binding NoiseHelp}" ContentTemplate="{StaticResource HelpStrip}" />

            </StackPanel>

            <StackPanel Margin="0,0,0,16">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox Grid.Column="0" Classes="compact" IsChecked="{Binding EdgeProtectionEnabled}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Edge protection" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="2" Classes="mono"
                           Text="{Binding EdgeProtectionAmount, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="1" Value="{Binding EdgeProtectionAmount}"
                      IsEnabled="{Binding EdgeProtectionEnabled}" />
              <TextBlock Classes="hint" Margin="0,5,0,0"
                         Text="Attenuates sharpening near strong edges, where halos are most visible." />
              <ContentControl Content="{Binding EdgeHelp}" ContentTemplate="{StaticResource HelpStrip}" />

            </StackPanel>

            <StackPanel Margin="0,0,0,4">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox Grid.Column="0" Classes="compact" IsChecked="{Binding HaloProtectionEnabled}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Halo limiter" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="2" Classes="mono"
                           Text="{Binding HaloProtectionAmount, StringFormat='{}{0:0.00}'}" />
              </Grid>
              <Slider Minimum="0" Maximum="1" Value="{Binding HaloProtectionAmount}"
                      IsEnabled="{Binding HaloProtectionEnabled}" />
              <TextBlock Classes="hint" Margin="0,5,0,0"
                         Text="Caps overshoot to a fraction of local contrast instead of clipping." />
              <ContentControl Content="{Binding HaloHelp}" ContentTemplate="{StaticResource HelpStrip}" />

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
