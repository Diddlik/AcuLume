<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AcuLume.Gui.Converters"
             xmlns:vm="using:AcuLume.Gui.ViewModels"
             x:Class="AcuLume.Gui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://aculume-gui/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:EnumMatchConverter x:Key="EnumMatch" />
      <conv:PathGeometryConverter x:Key="PathGeometry" />
      <conv:StarGridLengthConverter x:Key="StarLength" />
      <conv:BatchStatusColorConverter x:Key="StatusColor" />
      <conv:ScaleConverter x:Key="Scale" />

      <!-- Shared label/value row used by the info and settings views. -->
      <DataTemplate x:Key="InfoRowTemplate" DataType="vm:InfoRow">
        <Border BorderBrush="#14181C" BorderThickness="0,0,0,1" Padding="0,5">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Classes="label" FontSize="11.5" Text="{Binding Key}" />
            <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding Value}"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="#D2D7DC" />
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="PresetCardTemplate" DataType="vm:PresetCard">
        <Button Classes="card" Classes.selected="{Binding IsSelected}"
                Command="{Binding $parent[ItemsControl].((vm:PresetsViewModel)DataContext).SelectCommand}"
                CommandParameter="{Binding}">
          <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}"
                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
            <Border BorderBrush="#2E353C" BorderThickness="1" CornerRadius="3" Padding="5,1"
                    VerticalAlignment="Center">
              <TextBlock Classes="mono" FontSize="9" Text="{Binding Tag}" Foreground="#8B939C" />
            </Border>
          </StackPanel>
          <TextBlock FontSize="11" Text="{Binding Description}" TextWrapping="Wrap" LineHeight="16"
                     Foreground="#7C858D" Margin="0,0,0,9" />
          <!-- Wraps: three summaries rarely fit a card's width on one line. -->
          <WrapPanel Orientation="Horizontal">
            <TextBlock Classes="mono" FontSize="10" Margin="0,0,12,0" Foreground="{DynamicResource TextFaint}"
                       Text="{Binding FineSummary, StringFormat='F {0}'}" />
            <TextBlock Classes="mono" FontSize="10" Margin="0,0,12,0" Foreground="{DynamicResource TextFaint}"
                       Text="{Binding MediumSummary, StringFormat='M {0}'}" />
            <TextBlock Classes="mono" FontSize="10" Foreground="{DynamicResource TextFaint}"
                       Text="{Binding SizeSummary}" />
          </WrapPanel>
          </StackPanel>
        </Button>
      </DataTemplate>

      <!-- Same pairing without the separator, for use inside a card. -->
      <DataTemplate x:Key="CardRowTemplate" DataType="vm:InfoRow">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,7">
          <TextBlock Grid.Column="0" Classes="label" FontSize="11.5" Text="{Binding Key}" />
          <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding Value}"
                     HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://aculume-gui/Themes/Controls.axaml" />
  </Application.Styles>

</Application>
